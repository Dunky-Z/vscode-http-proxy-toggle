{
    "name": "http-proxy-toggle-soshnikov",
    "displayName": "http-proxy-toggle by Soshnikov",
    "description": "Toggle VS Code's HTTP proxy between home, office, and disabled states from the status bar.",
    "publisher": "soshnikov",
    "license": "SEE LICENSE IN LICENSE",
    "icon": "proxyIcon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Doka-NT/vscode-http-proxy-toggle.git"
    },
    "homepage": "https://github.com/Doka-NT/vscode-http-proxy-toggle#readme",
    "bugs": {
        "url": "https://github.com/Doka-NT/vscode-http-proxy-toggle/issues"
    },
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.84.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "proxy",
        "http-proxy",
        "vscode",
        "status-bar",
        "remote",
        "wsl"
    ],
    "galleryBanner": {
        "color": "#1F6FEB",
        "theme": "dark"
    },
    "pricing": "Free",
    "activationEvents": [
        "onStartupFinished",
        "onCommand:httpProxyToggle.toggle"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "httpProxyToggle.toggle",
                "title": "Toggle Proxy",
                "category": "HTTP Proxy Toggle"
            }
        ],
        "configuration": {
            "title": "HTTP Proxy Toggle",
            "properties": {
                "httpProxyToggle.home": {
                    "type": "string",
                    "description": "HTTP proxy URL for the Home profile. Leave empty to disable the proxy when this profile is selected.",
                    "default": ""
                },
                "httpProxyToggle.office": {
                    "type": "string",
                    "description": "HTTP proxy URL for the Office profile.",
                    "default": "http://127.0.0.1:7890"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.84.0",
        "@types/mocha": "^10.0.6",
        "@types/node": "18.x",
        "@typescript-eslint/eslint-plugin": "^7.7.1",
        "@typescript-eslint/parser": "^7.7.1",
        "eslint": "^8.57.0",
        "typescript": "^5.4.5",
        "@vscode/test-cli": "^0.0.9",
        "@vscode/test-electron": "^2.3.9"
    }
}
